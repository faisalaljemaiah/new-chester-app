rules_version = '2';

// Roles come from the auth custom claim "role" (patient, practitioner, admin), which only
// Cloud Functions can set. Anything that must be validated across documents (booking,
// transfers, schedule changes, scoring) goes through a function instead of a client write.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return signedIn() ? request.auth.token.get('role', '') : ''; }
    function isAdmin() { return role() == 'admin'; }
    // Admins are practitioners too (the clinic owner may also see patients).
    function isStaff() { return role() in ['practitioner', 'admin']; }
    function isPatient() { return role() == 'patient'; }

    function patientDoc(patientId) {
      return get(/databases/$(database)/documents/patients/$(patientId)).data;
    }
    function onCareTeam(patientId) {
      return isStaff() && uid() in patientDoc(patientId).careTeam;
    }
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ----- Accounts -------------------------------------------------------

    match /users/{userId} {
      allow read: if signedIn() && (uid() == userId || isAdmin());
      allow update: if signedIn() && uid() == userId
        && onlyChanges(['displayName', 'locale', 'photoUrl'])
        && request.resource.data.get('locale', 'en') in ['en', 'ar'];
    }

    match /practitioners/{practitionerId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Practitioners edit their own profile and weekly hours. Blocked and extra days only
      // change when an admin approves an availability request.
      allow update: if isAdmin() || (isStaff() && uid() == practitionerId && onlyChanges([
        'displayName', 'displayNameAr', 'title', 'titleAr', 'bio', 'bioAr', 'photoUrl',
        'languages', 'sessionMinutes', 'timeZone', 'weeklyHours'
      ]));
    }

    // ----- Patient files --------------------------------------------------

    match /patients/{patientId} {
      allow get: if (signedIn() && uid() == patientId) || isAdmin() || onCareTeam(patientId);
      // Staff list their own patients with where('careTeam', 'array-contains', uid).
      allow list: if isAdmin() || (isStaff() && uid() in resource.data.careTeam);
      allow update: if isAdmin()
        || (onCareTeam(patientId) && onlyChanges(['status'])
            && request.resource.data.status in ['active', 'on_hold', 'discharged'])
        || (signedIn() && uid() == patientId && onlyChanges(['phone']));

      // Clinical notes are for the care team only. Patients never read them.
      match /notes/{noteId} {
        allow read: if onCareTeam(patientId) || isAdmin();
        allow create: if onCareTeam(patientId)
          && request.resource.data.authorId == uid()
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 20000
          && request.resource.data.createdAt == request.time;
        allow update: if onCareTeam(patientId) && resource.data.authorId == uid()
          && onlyChanges(['body', 'updatedAt']) && request.resource.data.updatedAt == request.time;
        allow delete: if onCareTeam(patientId) && resource.data.authorId == uid();
      }

      match /tasks/{taskId} {
        allow read: if onCareTeam(patientId) || isAdmin();
        allow create: if onCareTeam(patientId)
          && request.resource.data.authorId == uid()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 500
          && request.resource.data.done == false;
        allow update: if onCareTeam(patientId) && onlyChanges(['done', 'title', 'dueDate']);
        allow delete: if onCareTeam(patientId);
      }
    }

    // ----- Appointments ---------------------------------------------------

    match /appointments/{appointmentId} {
      allow read: if signedIn() && (
        resource.data.patientId == uid()
        || resource.data.practitionerId == uid()
        || isAdmin()
        || onCareTeam(resource.data.patientId));
      // Created only by the bookAppointment function. The practitioner running the session
      // records the outcome and the meeting link.
      allow update: if isAdmin() || (isStaff() && resource.data.practitionerId == uid()
        && onlyChanges(['status', 'meetingUrl', 'cancelReason'])
        && request.resource.data.status in ['scheduled', 'completed', 'cancelled', 'no_show']);
    }

    // Booked start times per practitioner and day, with no patient details.
    match /bookedSlots/{slotId} {
      allow read: if signedIn();
    }

    // ----- Transfers ------------------------------------------------------

    match /transfers/{transferId} {
      allow read: if isAdmin() || (isStaff()
        && (resource.data.fromPractitionerId == uid() || resource.data.toPractitionerId == uid()));
      allow create: if isStaff()
        && request.resource.data.fromPractitionerId == uid()
        && request.resource.data.toPractitionerId != uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.reason is string
        && request.resource.data.keepAccess is bool
        && onCareTeam(request.resource.data.patientId);
      // The sender can withdraw a pending transfer. Accepting goes through respondToTransfer.
      allow update: if isStaff() && resource.data.fromPractitionerId == uid()
        && resource.data.status == 'pending'
        && onlyChanges(['status']) && request.resource.data.status == 'cancelled';
    }

    // ----- Availability requests -----------------------------------------

    match /availabilityRequests/{requestId} {
      allow read: if isAdmin() || (isStaff() && resource.data.practitionerId == uid());
      allow create: if isStaff()
        && request.resource.data.practitionerId == uid()
        && request.resource.data.status == 'pending'
        && request.resource.data.kind in ['unavailable', 'available']
        && request.resource.data.from <= request.resource.data.to;
      // Practitioners can withdraw a request until it is reviewed (reviewAvailabilityRequest).
      allow delete: if isStaff() && resource.data.practitionerId == uid() && resource.data.status == 'pending';
    }

    // ----- Templates and assessments ---------------------------------------

    match /templates/{templateId} {
      allow read: if isStaff() && (resource.data.shared == true || resource.data.ownerId == uid());
      allow create: if isStaff()
        && request.resource.data.ownerId == uid()
        && (request.resource.data.shared == false || isAdmin());
      allow update, delete: if isAdmin() || (isStaff() && resource.data.ownerId == uid()
        && request.resource.data.get('shared', false) == false);
    }

    match /assessmentForms/{formId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /assessmentAssignments/{assignmentId} {
      allow read: if signedIn() && (
        resource.data.patientId == uid()
        || resource.data.practitionerId == uid()
        || isAdmin()
        || onCareTeam(resource.data.patientId));
      allow create: if isStaff()
        && request.resource.data.practitionerId == uid()
        && request.resource.data.status == 'sent'
        && !('answers' in request.resource.data)
        && onCareTeam(request.resource.data.patientId);
      // The patient submits once. Scoring happens in onAssessmentSubmitted.
      allow update: if isPatient() && resource.data.patientId == uid()
        && resource.data.status == 'sent'
        && onlyChanges(['answers', 'status', 'completedAt'])
        && request.resource.data.status == 'completed'
        && request.resource.data.answers is map
        && request.resource.data.completedAt == request.time;
    }

    // Scores and safety flags. Written by the scoring function; patients can't read them.
    match /assessmentResults/{assignmentId} {
      allow read: if isAdmin()
        || (isStaff() && resource.data.practitionerId == uid())
        || onCareTeam(resource.data.patientId);
      allow update: if onCareTeam(resource.data.patientId) && onlyChanges(['reviewed']);
    }

    // ----- Messaging -------------------------------------------------------

    match /conversations/{conversationId} {
      allow read: if signedIn()
        && (resource.data.patientId == uid() || resource.data.practitionerId == uid());

      match /messages/{messageId} {
        function convo() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }
        function participant() {
          return signedIn() && (convo().patientId == uid() || convo().practitionerId == uid());
        }
        allow read: if participant();
        allow create: if participant()
          && request.resource.data.senderId == uid()
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.createdAt == request.time
          // Only the practitioner sends templates and check-in forms.
          && (isStaff() || !(('templateId' in request.resource.data) || ('assessmentAssignmentId' in request.resource.data)));
        // Read receipts from the other side of the conversation.
        allow update: if participant() && resource.data.senderId != uid()
          && onlyChanges(['readAt']) && request.resource.data.readAt == request.time;
      }
    }
  }
}
