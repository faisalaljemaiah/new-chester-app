{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "../functions/lib",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR/..\" run build"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true,
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "eventarc": {
      "host": "127.0.0.1",
      "port": 9299
    },
    "hosting": {
      "host": "127.0.0.1",
      "port": 5000
    }
  },
  "hosting": {
    "public": "../apps/dashboard/out",
    "cleanUrls": true,
    "predeploy": [
      "npm --prefix \"$PROJECT_DIR/../apps/dashboard\" run build"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ]
  }
}