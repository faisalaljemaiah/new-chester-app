{
  "name": "chester-clinic",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "app": "npm run start -w apps/clinic",
    "web": "npm run web -w apps/clinic",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:sql": "tsx supabase/scripts/make-seed.mts",
    "test:db": "tsx --test supabase/tests/*.test.mts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@chester/shared": "*",
    "tsx": "^4.20.0"
  }
}
