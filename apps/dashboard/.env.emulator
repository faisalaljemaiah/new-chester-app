# Used by `npm run dev:emulator` to run against the local Firebase emulators with a demo project.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-chester.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-chester
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FIREBASE_FUNCTIONS_REGION=me-central2
NEXT_PUBLIC_USE_EMULATORS=true
