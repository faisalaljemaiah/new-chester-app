# Supabase project URL and publishable (anon) key: Project Settings > API Keys.
# Never put the secret / service_role key here; it would ship inside the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Emergency number shown when a patient answers a self-harm question
EXPO_PUBLIC_EMERGENCY_NUMBER=911
