# Used for local testing against the Firebase emulators with a demo project.
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-chester.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-chester
EXPO_PUBLIC_FIREBASE_APP_ID=demo-app
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=me-central2
EXPO_PUBLIC_USE_EMULATORS=true
