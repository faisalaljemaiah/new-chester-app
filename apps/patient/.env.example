# Firebase web app config (Project settings > General > Your apps). These values are not secrets,
# but keep real values in .env.local, which git ignores.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Region the Cloud Functions are deployed to (must match functions/src/index.ts)
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=me-central2
# Set to "true" to talk to the local Firebase emulators
EXPO_PUBLIC_USE_EMULATORS=false
# Emergency number shown when a patient answers a self-harm question
EXPO_PUBLIC_EMERGENCY_NUMBER=911
