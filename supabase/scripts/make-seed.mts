// Writes supabase/seed.sql: the PHQ-9 and GAD-7 forms and the clinic's starter templates.
// Run with `npm run seed:sql` after changing packages/shared/src/assessments.ts.
import { writeFileSync } from "node:fs";
import { SEED_FORMS } from "@chester/shared";

const lit = (v: string | null | undefined) => (v == null ? "null" : `'${v.replaceAll("'", "''")}'`);
const json = (v: unknown) => `${lit(JSON.stringify(v))}::jsonb`;

const templates = [
  {
    title: "Welcome",
    body: "Welcome to New Chester Clinic. I'm looking forward to our first session. If anything comes up before then, message me here.",
  },
  {
    title: "Session reminder",
    body: "A reminder that our session is coming up. Please find a quiet, private place and join from the app a few minutes early.",
  },
  {
    title: "PHQ-9 check-in",
    formId: "phq9",
    body: "Please fill in this short questionnaire before our next session. It takes about 3 minutes.",
  },
  {
    title: "GAD-7 check-in",
    formId: "gad7",
    body: "Please fill in this short questionnaire about anxiety before our next session.",
  },
];

const lines = ["-- Generated by supabase/scripts/make-seed.mts. Safe to run more than once.", ""];
for (const f of Object.values(SEED_FORMS)) {
  lines.push(
    `insert into public.assessment_forms (id, code, title, title_ar, instructions, instructions_ar, questions, bands, safety_items, active)`,
    `values (${lit(f.id)}, ${lit(f.code)}, ${lit(f.title)}, ${lit(f.title_ar)}, ${lit(f.instructions)}, ${lit(f.instructions_ar)},`,
    `  ${json(f.questions)},`,
    `  ${json(f.bands)}, ${lit(`{${f.safety_items.join(",")}}`)}, ${f.active})`,
    `on conflict (id) do update set code = excluded.code, title = excluded.title, instructions = excluded.instructions,`,
    `  questions = excluded.questions, bands = excluded.bands, safety_items = excluded.safety_items;`,
    "",
  );
}
for (const t of templates) {
  lines.push(
    `insert into public.templates (owner_id, shared, kind, title, body, locale, form_id)`,
    `select null, true, ${lit(t.formId ? "assessment" : "message")}, ${lit(t.title)}, ${lit(t.body)}, 'en', ${lit(t.formId)}`,
    `where not exists (select 1 from public.templates where shared and owner_id is null and title = ${lit(t.title)});`,
    "",
  );
}
writeFileSync(new URL("../seed.sql", import.meta.url), lines.join("\n"));
console.log(`Wrote ${Object.keys(SEED_FORMS).length} forms and ${templates.length} templates to supabase/seed.sql`);
